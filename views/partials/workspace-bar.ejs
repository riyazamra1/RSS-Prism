<% if (!isPreview) { %>
<style>
  .rp-app-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:8px 18px;background:#191b20;color:#e5e7eb;font:600 13px/1.4 system-ui,-apple-system,sans-serif;border-bottom:1px solid #2e323c}
  .rp-app-bar__brand{display:inline-flex;align-items:center;gap:8px;color:#fff;text-decoration:none;font-weight:800;letter-spacing:.02em}
  .rp-app-bar__badge{padding:2px 7px;border-radius:5px;background:#b88a2b;color:#fff;font-size:10px;text-transform:uppercase;letter-spacing:.08em}
  .rp-app-bar__nav{display:flex;align-items:center;gap:4px;flex-wrap:wrap}
  .rp-app-bar__nav a{padding:6px 11px;border-radius:7px;color:#cbd5e1;text-decoration:none;transition:background .15s,color .15s}
  .rp-app-bar__nav a:hover,.rp-app-bar__nav a.is-active{background:rgba(255,255,255,.12);color:#fff}
  .rp-app-bar__nav a.is-builder{background:rgba(108,46,185,.35);color:#e9d5ff}
  .rp-app-bar__nav a.is-builder.is-active{background:#6c2eb9;color:#fff}
</style>
<div class="rp-app-bar" role="navigation" aria-label="RSS Prism Workspace">
  <a class="rp-app-bar__brand" href="/">
    <span>RSS Prism</span>
    <span class="rp-app-bar__badge">Free 1.3.13</span>
  </a>
  <div class="rp-app-bar__nav">
    <a href="/" class="<%= activeRoute === 'home' ? 'is-active' : '' %>">Site Home</a>
    <a href="/builder" class="is-builder <%= activeRoute === 'builder' ? 'is-active' : '' %>">Visual Builder</a>
    <a href="/studio" class="<%= activeRoute === 'studio' ? 'is-active' : '' %>">Theme Studio</a>
    <a href="/pages" class="<%= activeRoute === 'pages' ? 'is-active' : '' %>">Pages</a>
    <a href="/welcome" class="<%= activeRoute === 'welcome' ? 'is-active' : '' %>">Welcome &amp; Roadmap</a>
    <a href="/licensing" class="<%= activeRoute === 'licensing' ? 'is-active' : '' %>">Licensing &amp; Pricing</a>
  </div>
</div>
<% } %>
