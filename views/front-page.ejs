<%- include('partials/theme-head', { pageTitle: 'Home', bodyClasses: (customizer.showHeroVisual ? '' : 'rp-hero-visual-hidden ') + 'rp-content-align--' + customizer.contentAlignment }) %>
<%- include('partials/theme-header') %>

<main id="content" class="rss-home">
  <% if (searchQuery) { %>
    <section class="rp-section rp-container">
      <p class="rp-eyebrow">SEARCH RESULTS</p>
      <h2>Results for "<%= searchQuery %>"</h2>
      <% if (matchingPages.length) { %>
        <div class="entry-grid">
          <% matchingPages.forEach(function(pg){ %>
            <article class="entry-card">
              <div class="entry-card__body">
                <h3 class="entry-title"><a href="/pages/<%= pg.id %>"><%= pg.title %></a></h3>
                <p class="entry-excerpt">Created from Prism Template #<%= pg.templateId %> (<%= pg.status %>).</p>
                <a class="entry-read-more" href="/pages/<%= pg.id %>">Open page →</a>
              </div>
            </article>
          <% }); %>
        </div>
      <% } else { %>
        <p>No published Prism pages matched your search. <a href="/">Return to homepage</a>.</p>
      <% } %>
    </section>
  <% } %>

  <section class="rp-hero rss-hero">
    <div class="rp-container rp-hero__inner">
      <div>
        <p class="rp-eyebrow"><%= customizer.heroEyebrow %></p>
        <h1><%= customizer.heroTitle %></h1>
        <p class="rp-hero__text"><%= customizer.heroText %></p>
        <div class="rp-hero__actions">
          <a class="rp-button" href="/builder">Launch Visual Builder →</a>
          <a class="rp-button rp-button--outline" href="#projects">Explore RSS projects</a>
          <a class="rp-button rp-button--outline" href="/studio">Open Theme Studio</a>
        </div>
        <p class="rss-hero-note">Independent digital solutions · A security-aware approach · Free public offering</p>
      </div>
      <div class="rp-hero__visual rss-hero-art" aria-hidden="true">
        <div class="rp-hero__orb"></div>
        <span class="rss-orbit rss-orbit--one"></span>
        <span class="rss-orbit rss-orbit--two"></span>
        <div class="rss-monogram">RSS<span>PRISM</span></div>
      </div>
    </div>
  </section>

  <section class="rp-section rp-container rss-intro" id="about-rss">
    <p class="rp-eyebrow">WHO WE ARE</p>
    <h2>Technology built around real needs.</h2>
    <p class="rss-section-lead">Razeen Secure Solution (RSS) is a technology and digital-solutions brand focused on building useful software, web experiences, and tools that help people manage work more clearly. Our guiding idea is simple: make technology practical, understandable, and designed with security in mind.</p>
    <div class="rss-facts">
      <div><strong>Business</strong><span>Razeen Secure Solution (RSS)</span></div>
      <div><strong>Leadership</strong><span>A C M Riyaz, COE · Established 2015</span></div>
      <div><strong>Our mission</strong><span>Turn ideas into useful digital solutions through practical technology and reliable service.</span></div>
    </div>
    <div class="rss-business-details">
      <h3>What Razeen Secure Solution does</h3>
      <p>RSS works across software, IT infrastructure, and security technology. Our services include:</p>
      <ul class="rss-service-list">
        <li>Mobile and PC software development</li>
        <li>CCTV installation and security camera solutions</li>
        <li>Computer networking and network setup</li>
        <li>System administration and maintenance</li>
        <li>Technical troubleshooting and support</li>
        <li>AI-enabled tools and software solutions</li>
        <li>Cloud services and software integrations</li>
        <li>Website development and digital experiences</li>
      </ul>
    </div>
  </section>

  <section class="rp-section rss-section-tint" id="features">
    <div class="rp-container">
      <p class="rp-eyebrow">WHAT WE FOCUS ON</p>
      <h2>Useful features. Clear experiences.</h2>
      <p class="rss-section-lead">RSS projects aim to combine practical functionality with straightforward user experiences and security-aware engineering.</p>
      <div class="rp-card-grid rss-feature-grid">
        <article class="rp-card"><div class="rp-card__icon">✦</div><h3>Website experiences</h3><p>Responsive websites, flexible layouts, reusable content sections, and brand-consistent presentation.</p></article>
        <article class="rp-card"><div class="rp-card__icon">▤</div><h3>Project workflows</h3><p>Tools and portal concepts for organizing projects, requests, approvals, and progress in a clearer workflow.</p></article>
        <article class="rp-card"><div class="rp-card__icon">⌁</div><h3>Security-aware design</h3><p>Attention to access control, input validation, account verification, and safe handling of application data.</p></article>
        <article class="rp-card"><div class="rp-card__icon">◈</div><h3>Responsive interfaces</h3><p>Layouts designed to adapt across desktop and mobile screens, with readable content and accessible controls.</p></article>
        <article class="rp-card"><div class="rp-card__icon">⚙</div><h3>Practical automation</h3><p>Exploring ways to reduce repetitive work through useful integrations and well-defined processes.</p></article>
        <article class="rp-card"><div class="rp-card__icon">◎</div><h3>Transparent delivery</h3><p>Features and project status should be communicated clearly, without presenting planned work as already released.</p></article>
      </div>
    </div>
  </section>

  <section class="rp-section rp-container" id="projects">
    <p class="rp-eyebrow">THE RSS ECOSYSTEM</p>
    <h2>Projects and products</h2>
    <p class="rss-section-lead">A snapshot of the RSS project portfolio. Each project can evolve independently; availability depends on its current development and release status.</p>
    <div class="rp-card-grid rss-project-grid">
      <article class="rp-card rss-project-card"><span class="rss-project-label">WordPress theme</span><h3>RSS Prism</h3><p>A responsive theme with configurable colours, header and footer layouts, homepage sections, article layouts, and site-personalization controls.</p><a href="/studio">Open Theme Studio <span aria-hidden="true">→</span></a></article>
      <article class="rp-card rss-project-card"><span class="rss-project-label">Site building</span><h3>RSS Prism Builder</h3><p>Visual Divi-style layout builder with draggable sections, rows, columns, nested containers, responsive settings, and saved templates.</p><a href="/builder">Open Visual Builder <span aria-hidden="true">→</span></a></article>
      <article class="rp-card rss-project-card"><span class="rss-project-label">Licensing API</span><h3>RSS Prism Licensing</h3><p>Email-bound licence verification, site activation tracking, and checkout webhook foundation backed by SHA-256 verification.</p><a href="/licensing">Open Licensing Console <span aria-hidden="true">→</span></a></article>
      <article class="rp-card rss-project-card"><span class="rss-project-label">Project management</span><h3>RSS Project Manager</h3><p>A project-management portal initiative for organizing project information and workflows. Features should be checked against the current deployed release.</p><a href="https://github.com/riyazamra1/RSS-Prism" target="_blank" rel="noopener noreferrer">View RSS repository <span aria-hidden="true">→</span></a></article>
      <article class="rp-card rss-project-card"><span class="rss-project-label">Core services</span><h3>RSS Core</h3><p>A shared-services project supporting connected RSS applications and their account or service workflows, subject to the deployed configuration.</p><a href="https://github.com/riyazamra1/RSS-Prism" target="_blank" rel="noopener noreferrer">View RSS repository <span aria-hidden="true">→</span></a></article>
      <article class="rp-card rss-project-card rss-project-card--planned"><span class="rss-project-label">Future project</span><h3>RSS APK Analyzer</h3><p>Planned Android APK inspection and analysis tooling, including permission review, code/resource search, comparison, and authorized modification workflows.</p><span class="rss-status-note">Planned · Not yet released</span></article>
    </div>
  </section>

  <section class="rp-section rss-security-section" id="security">
    <div class="rp-container rss-security-layout">
      <div>
        <p class="rp-eyebrow">SECURITY AND TRUST</p>
        <h2>Security is a design priority.</h2>
        <p class="rss-section-lead">RSS aims to apply security-conscious practices appropriate to each project, including access checks, input validation, secure account flows, and careful treatment of sensitive information.</p>
      </div>
      <div class="rss-security-list">
        <div><span class="rss-security-mark">01</span><div><h3>Access control</h3><p>Protected actions should verify permissions on the server, not rely only on what the interface displays.</p></div></div>
        <div><span class="rss-security-mark">02</span><div><h3>Account verification</h3><p>Where supported, verification and approval flows help confirm account ownership and control access.</p></div></div>
        <div><span class="rss-security-mark">03</span><div><h3>Input and data handling</h3><p>Validation, sanitization, and minimal exposure of sensitive data are important implementation goals.</p></div></div>
        <div><span class="rss-security-mark">04</span><div><h3>Honest security claims</h3><p>Security controls vary by product and deployment. RSS does not claim a certification or guarantee that has not been independently verified.</p></div></div>
      </div>
    </div>
  </section>

  <section class="rp-section rp-container rss-pricing" id="pricing">
    <div class="rp-cta">
      <p class="rp-eyebrow">PUBLIC OFFERING</p>
      <h2>Start with Free.</h2>
      <p><%= plansCatalog.note %></p>
      <a class="rp-button" href="/licensing">View Free Catalog &amp; Licensing →</a>
    </div>
  </section>

  <section class="rp-section rp-container" id="latest">
    <p class="rp-eyebrow">BUILT WITH PRISM BUILDER</p>
    <h2>Published pages</h2>
    <% if (publishedPages.length) { %>
      <div class="entry-grid">
        <% publishedPages.forEach(function(pg){ %>
          <article class="entry-card">
            <div class="entry-card__body">
              <div class="entry-meta"><%= new Date(pg.createdAt).toLocaleDateString() %> · <%= pg.status %></div>
              <h3 class="entry-title"><a href="/pages/<%= pg.id %>"><%= pg.title %></a></h3>
              <p class="entry-excerpt">Built visually from Prism Template #<%= pg.templateId %>.</p>
              <a class="entry-read-more" href="/pages/<%= pg.id %>">View page →</a>
            </div>
          </article>
        <% }); %>
      </div>
    <% } else { %>
      <p>Pages created from the Visual Builder will appear here.</p>
    <% } %>
  </section>

  <section class="rp-section rp-container" id="contact">
    <div class="rp-cta">
      <p class="rp-eyebrow">LET'S CONNECT</p>
      <h2>Have an idea to build?</h2>
      <p>Contact Razeen Secure Solution for software, CCTV, networking, IT support, and digital-solutions enquiries.</p>
      <div class="rss-contact-details">
        <p><strong>Website</strong><br><a href="https://www.rsscctvsolution.eu.cc/" target="_blank" rel="noopener noreferrer">www.rsscctvsolution.eu.cc</a></p>
        <p><strong>Email</strong><br><a href="mailto:rsscctvsolution@gmail.com">rsscctvsolution@gmail.com</a></p>
        <p><strong>Phone</strong><br><a href="tel:+94771155504">077 115 5504</a> <span aria-hidden="true">|</span> <a href="tel:+94701555504">070 155 5504</a></p>
      </div>
      <a class="rp-button" href="https://www.rsscctvsolution.eu.cc/" target="_blank" rel="noopener noreferrer">Visit RSS website →</a>
    </div>
  </section>
</main>

<%- include('partials/theme-footer') %>
